# =============================================================================
# FoldReader AI 功能开发 / 实测凭据模板（docs/AI功能需求与实施.md M14）
#
# 使用方法：复制本文件为仓库根目录的 .env 并填写实际值。
# .env 已被 .gitignore 排除，与 key.properties 同一口径：绝不允许入库。
# 用途：M14 起 AI 功能的真实联调与实测（区别于 MockWebServer 冒烟测试），
# 供「测试连接」、选中即译、按页翻译等真实调用读取。
# =============================================================================

# 协议预设（R1 三选一）：
#   openai-chat       OpenAI Chat Completions（DeepSeek / 通义等兼容服务也走这个）
#   openai-responses  OpenAI Responses
#   anthropic         Anthropic Messages
AI_PROTOCOL=openai-chat

# 服务商地址：只填 scheme + host（可带端口），不要带 /v1/chat/completions 之类的路径，
# 路径由各 Provider 按协议拼接。
# 常见预设：
#   DeepSeek    https://api.deepseek.com
#   OpenAI      https://api.openai.com
#   Anthropic   https://api.anthropic.com
#   通义千问     https://dashscope.aliyuncs.com/compatible-mode
AI_BASE_URL=https://api.deepseek.com

# API Key
AI_API_KEY=

# 通用模型：章节规则生成 / 清洗配方推荐 / 元数据补全
AI_MODEL_GENERAL=deepseek-chat

# 翻译模型（R3：与通用模型分开配置，翻译对质量敏感可单独选好模型）
AI_MODEL_TRANSLATION=deepseek-chat

# 视觉模型（图片识别实测专用；DeepSeek 的视觉能力在 deepseek-flash 上，与文本模型不同名）
AI_MODEL_VISION=deepseek-flash

# -----------------------------------------------------------------------------
# 以下为可选项，不填则用应用默认值
# -----------------------------------------------------------------------------

# 默认目标语言（R4）：zh-Hans / zh-Hant / en / ja
# AI_TARGET_LANG=zh-Hans

# 请求超时（秒），流式读取超时单独生效
# AI_TIMEOUT_SECONDS=60
