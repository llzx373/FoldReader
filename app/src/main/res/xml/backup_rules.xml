<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Auto Backup (API 23+).
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore

   排除 ai_credentials.xml：AI 服务的 API key 密文存于该 SharedPreferences 文件，
   即使已加密也绝不随备份上云，换机后由用户重新配置。
-->
<full-backup-content>
    <exclude domain="sharedpref" path="ai_credentials.xml"/>
</full-backup-content>
