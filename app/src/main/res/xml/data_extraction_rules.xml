<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (API 31+).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.

   云备份与设备迁移两处都排除 ai_credentials.xml：AI 服务的 API key 密文
   存于该 SharedPreferences 文件，即使已加密也绝不上云、不随换机迁移，
   由用户在新设备上重新配置。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai_credentials.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai_credentials.xml"/>
    </device-transfer>
</data-extraction-rules>
